# AIMternet-Cafe POC configuration.
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below has a safe default or fails fast at startup with a named error.

# ---------- paths (§2) ----------
# All optional: each falls back to a repo-relative path so tests run anywhere.
AIMTERNET_RAW_LANDING=/opt/aimternet/data/raw-landing     # READ-ONLY source of truth
AIMTERNET_DAG_INPUT=/opt/airflow/input/raw-landing        # what the DAG reads
AIMTERNET_WORK_DIR=/opt/aimternet/work                    # scratch, safe to delete
AIMTERNET_QUARANTINE_DIR=/opt/aimternet/quarantine
AIRFLOW_HOME=/opt/airflow

# ---------- AWS ----------
# Prefer the EC2 instance role. Static keys, if used, come from the environment only.
AWS_REGION=us-east-1
AIMTERNET_S3_BUCKET=your-bucket-name
AIMTERNET_S3_BRONZE_PREFIX=bronze
AIMTERNET_S3_SILVER_PREFIX=silver
AIMTERNET_S3_GOLD_PREFIX=gold
AIMTERNET_S3_QUARANTINE_PREFIX=quarantine
AIMTERNET_S3_MANIFEST_PREFIX=manifests

# ---------- RDS PostgreSQL (operational / OLTP) ----------
AIMTERNET_PG_HOST=your-instance.rds.amazonaws.com
AIMTERNET_PG_PORT=5432
AIMTERNET_PG_DATABASE=postgres
AIMTERNET_PG_USER=postgres
AIMTERNET_PG_PASSWORD=change-me
AIMTERNET_PG_SCHEMA=aimternet_oltp
# Read-only role used by notebooks/db_lens.ipynb
AIMTERNET_PG_RO_USER=aimternet_ro
AIMTERNET_PG_RO_PASSWORD=change-me

# ---------- Redshift (analytical / OLAP) ----------
AIMTERNET_REDSHIFT_HOST=your-cluster.redshift.amazonaws.com
AIMTERNET_REDSHIFT_PORT=5439
AIMTERNET_REDSHIFT_DATABASE=dev
AIMTERNET_REDSHIFT_USER=your-user
AIMTERNET_REDSHIFT_PASSWORD=change-me
AIMTERNET_REDSHIFT_SCHEMA=aimternet_olap
# IAM role for COPY. Leave blank to try `IAM_ROLE default`, then fall back to batched INSERT.
AIMTERNET_REDSHIFT_COPY_IAM_ROLE=

# ---------- DynamoDB ----------
AIMTERNET_DDB_EVENTS_TABLE=aimternet_workstation_events
AIMTERNET_DDB_TELEMETRY_TABLE=aimternet_workstation_telemetry
# F2: source expires_at values are ALREADY IN THE PAST (data is 2026-07/08).
# Enabling TTL would purge ~61 of 62 days within ~48h of loading. Default off.
AIMTERNET_DDB_TTL_ENABLED=false
# Optional: shift expires_at forward by N days to demo real expiry. 0 = write verbatim.
AIMTERNET_DDB_TTL_SHIFT_DAYS=0

# ---------- POC policy (§0.5 — assumptions live here, not in code) ----------
# How to resolve the 840 members referenced by transactions but never defined (D2).
AIMTERNET_ORPHAN_MEMBER_POLICY=synthesize_stub    # or: quarantine
# Days of telemetry the loaders ingest. 62 = the full window.
AIMTERNET_TELEMETRY_DAYS=62
AIMTERNET_LOAD_THREADS=8
AIMTERNET_BATCH_SIZE=1000

# ---------- API ----------
AIMTERNET_API_BASE_URL=http://127.0.0.1:8000
AIMTERNET_API_HOST=0.0.0.0
AIMTERNET_API_PORT=8000
# Where the metrics API reads "today"/live numbers from. Redshift lags the DAG cadence,
# so a POS check-in would not appear on the dashboard until the next run.
AIMTERNET_METRICS_LIVE_SOURCE=rds                 # or: redshift

# ---------- Airflow REST (notebooks/airflow_lens.ipynb) ----------
AIMTERNET_AIRFLOW_API_URL=http://127.0.0.1:8080
AIMTERNET_AIRFLOW_USERNAME=admin
AIMTERNET_AIRFLOW_PASSWORD=change-me
